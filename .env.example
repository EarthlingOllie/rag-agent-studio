# Copy to .env to override the defaults used by `make dev`.
# Every backend setting is validated at startup; see backend/app/core/settings.py.
ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://studio:studio@postgres:5432/studio
REDIS_URL=redis://redis:6379/0
# Traces go to Logfire when this is set, and to stdout as JSON lines otherwise.
# LOGFIRE_TOKEN=
# How long a Studio session lasts, in seconds (default 14 days).
# SESSION_TTL_SECONDS=1209600
# Sign-in protection (defaults shown). After the "delay after" count of failed sign-ins,
# each attempt waits 1, 2, 4… seconds (up to the max); after the "lockout after" count,
# sign-in is locked for SIGN_IN_LOCKOUT_SECONDS. Counted per account and per IP address.
# SIGN_IN_ACCOUNT_DELAY_AFTER_FAILURES=3
# SIGN_IN_ACCOUNT_LOCKOUT_AFTER_FAILURES=10
# SIGN_IN_IP_DELAY_AFTER_FAILURES=20
# SIGN_IN_IP_LOCKOUT_AFTER_FAILURES=100
# SIGN_IN_DELAY_BASE_SECONDS=1
# SIGN_IN_DELAY_MAX_SECONDS=30
# SIGN_IN_LOCKOUT_SECONDS=900
# The local key wrapper's key for envelope-encrypted secrets: 32 bytes, base64-encoded.
# Generate one with `openssl rand -base64 32`. docker compose has a development default.
# LOCAL_KEY_WRAPPER_KEY=
# How long a sign-in waits for its MFA code, in seconds (default 5 minutes).
# MFA_PENDING_TTL_SECONDS=300
# How long a password reset link works, in seconds (default 1 hour).
# PASSWORD_RESET_TTL_SECONDS=3600
# How long an invite link works, in seconds (default 7 days).
# INVITE_TTL_SECONDS=604800
# The Studio's public address, used in links in emails.
# STUDIO_URL=http://localhost:5173
# Mailer adapter: outbox (in memory, tests), smtp (Mailpit locally) or ses (AWS SES).
# MAILER=smtp
# MAIL_FROM=RAG Agent Studio <no-reply@rag-agent-studio.invalid>
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# SMTP_TIMEOUT_SECONDS=10
# SES_REGION=eu-west-2
