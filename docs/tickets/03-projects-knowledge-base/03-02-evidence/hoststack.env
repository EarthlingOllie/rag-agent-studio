# The stack's services from docker compose (project rag0302); API, worker and Studio run on the
# host from the branch, because the sandbox disk can't hold the rebuilt images.
export ENVIRONMENT=local
export DATABASE_URL=postgresql+asyncpg://studio:studio@localhost:45732/studio
export REDIS_URL=redis://localhost:46679/0
export LOCAL_KEY_WRAPPER_KEY=bG9jYWwtZGV2LW9ubHkta2V5LW5vdC1hLXNlY3JldCE=
export CREDENTIAL_VERIFIER=fake
export MAILER=smtp SMTP_HOST=localhost SMTP_PORT=41325
export STUDIO_URL=http://localhost:45473
export OBJECT_STORE=s3 OBJECT_STORE_BUCKET=studio-documents OBJECT_STORE_CREATE_BUCKET=true
export OBJECT_STORE_ENDPOINT_URL=http://localhost:49300 OBJECT_STORE_PUBLIC_ENDPOINT_URL=http://localhost:45473
