# --- mutate.sh ---
#!/usr/bin/env bash
# Each mutation breaks one acceptance criterion; the named tests must fail. The tree is restored after each.
set -u
WT=$1; cd "$WT"
export TEST_REDIS_URL=redis://localhost:6379/11
DB=postgresql+asyncpg://studio:studio@localhost:5432
run() { # name, file, python-replace old, new, test command
  local name=$1 file=$2 old=$3 new=$4; shift 4
  echo "=== mutation: $name ($file)"
  python3 - "$file" "$old" "$new" <<'PY'
import sys; p,o,n=sys.argv[1:]; s=open(p).read(); assert o in s, "pattern missing"; open(p,'w').write(s.replace(o,n,1))
PY
  git --no-pager diff --stat -- "$file" | head -1
  (eval "$@") > /tmp/mut.out 2>&1; rc=$?
  grep -E "^(FAILED|ERROR)|×|Tests .*failed|passed|failed" /tmp/mut.out | grep -v "^ *✓" | head -8
  echo "exit=$rc (non-zero = mutation caught)"
  git checkout -q -- "$file"
}
B="cd backend && TEST_DATABASE_URL=$DB/studio_test_0105 uv run pytest -q -p no:cacheprovider --no-cov tests/integration/test_audit_events.py tests/integration/test_tenant_isolation.py"
run "no redaction" backend/app/audit/service.py 'REDACTED if SECRET_LIKE_KEY.search(str(key)) else redact(item)' 'redact(item)' "$B"
run "redaction skips lists" backend/app/audit/service.py 'return [redact(item) for item in value]' 'return list(value)' "$B"
run "Editors allowed" backend/app/tenancy/policy.py 'if scope.role is not Role.OWNER:' 'if False:' "$B"
run "sign-up not recorded" backend/app/auth/service.py 'action="organisation.created"' 'action="organisation.made"' "$B"
run "action filter ignored" backend/app/audit/service.py 'query = query.where(AuditEvent.action == where.action)' 'pass' "$B"
run "actor filter ignored" backend/app/audit/service.py 'query = query.where(AuditEvent.actor_id == where.actor_id)' 'pass' "$B"
run "end inclusive" backend/app/audit/service.py 'AuditEvent.occurred_at < where.end' 'AuditEvent.occurred_at <= where.end' "$B"
run "oldest first" backend/app/audit/service.py 'AuditEvent.occurred_at.desc(), AuditEvent.id.desc()' 'AuditEvent.occurred_at, AuditEvent.id' "$B"
run "not scoped to the Organisation" backend/app/audit/service.py 'query = select(AuditEvent).where(AuditEvent.organisation_id == scope.organisation_id)' 'query = select(AuditEvent)' "$B"
PSQL="PGPASSWORD=studio psql -q -h localhost -U studio -d postgres"
PSQL="PGPASSWORD=studio psql -q -h localhost -U studio -d postgres"
run "append-only trigger lets changes through (fresh database)" backend/migrations/versions/20261105_0003_audit_events.py "RAISE EXCEPTION 'audit_events is append-only" "RETURN COALESCE(NEW, OLD); RAISE EXCEPTION 'audit_events is append-only" "$PSQL -c 'drop database if exists studio_mut_0105' -c 'create database studio_mut_0105' && cd backend && TEST_DATABASE_URL=$DB/studio_mut_0105 uv run pytest -q -p no:cacheprovider --no-cov tests/integration/test_audit_events.py -k cannot_be_changed"
F="cd frontend && pnpm vitest run apps/studio/src/settings"
run "Audit tab shown to Editors" frontend/apps/studio/src/settings/OrganisationSettings.tsx '{isOwner && (' '{(isOwner || true) && (' "$F"
run "Editors get the audit log" frontend/apps/studio/src/settings/AuditPage.tsx '{isOwner ? (' '{isOwner || true ? (' "$F"
run "To date exclusive" frontend/apps/studio/src/settings/audit.ts 'startOfUtcDay(filters.to, 1)' 'startOfUtcDay(filters.to)' "$F"
run "filters keep the page" frontend/apps/studio/src/settings/AuditPage.tsx 'setPage(1);' '' "$F"
