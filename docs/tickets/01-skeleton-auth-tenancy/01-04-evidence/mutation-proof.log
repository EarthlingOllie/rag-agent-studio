# ---- mutate.sh ----
#!/usr/bin/env bash
# Each mutation breaks one acceptance criterion in the committed code; the named tests must fail.
# The file is restored with `git checkout` after each one.
set -u
cd "$1/backend"
run() {
  local label=$1 file=$2 old=$3 new=$4; shift 4
  echo "=== mutation: $label ($file)"
  python3 - "$file" "$old" "$new" <<'PY'
import sys
p, old, new = sys.argv[1:]
s = open(p).read()
assert s.count(old) == 1, f"{old!r} occurs {s.count(old)} times"
open(p, "w").write(s.replace(old, new))
PY
  git --no-pager diff -U0 -- "$file" | grep '^[-+] '
  uv run pytest -q --no-cov "$@" 2>&1 | grep -E '^(FAILED|[0-9]+ (passed|failed))'
  git checkout -q -- "$file"
}
run "sign-up statements autocommit one by one" app/auth/service.py \
  "        async with session.begin():
            await create_" "        async with session.begin():
            await session.connection(execution_options={'isolation_level': 'AUTOCOMMIT'})
            await create_" tests/integration/test_sign_up.py
run "argon2i instead of argon2id" app/auth/passwords.py "Type.ID" "Type.I" tests/integration/test_sign_up.py
run "cookie not Secure" app/auth/api.py "        secure=True,
        httponly=True," "        secure=False,
        httponly=True," tests/integration/test_sign_up.py
run "cookie readable by scripts" app/auth/api.py "        secure=True,
        httponly=True," "        secure=True,
        httponly=False," tests/integration/test_sign_up.py
run "cookie SameSite=Strict" app/auth/api.py '        httponly=True,
        samesite="lax",' '        httponly=True,
        samesite="strict",' tests/integration/test_sign_up.py
run "session not rotated on sign-in" app/auth/api.py "    if old is not None:
        await sessions.delete(old)" "    pass" tests/integration/test_sign_in_and_out.py
run "sign-out only clears the cookie" app/auth/api.py "    if token is not None:
        await sessions.delete(token)" "    pass" tests/integration/test_sign_in_and_out.py
run "an unknown email gets its own error" app/auth/api.py "    if member is None:
        raise HTTPException(status.HTTP_401_UNAUTHORIZED, SIGN_IN_FAILED)" "    if member is None and body.password == 'wrong password':
        raise HTTPException(status.HTTP_401_UNAUTHORIZED, SIGN_IN_FAILED)
    if member is None:
        raise HTTPException(status.HTTP_401_UNAUTHORIZED, 'No such Member')" tests/integration/test_sign_in_and_out.py
run "scope ignores which Member is asking" app/tenancy/repository.py "            Membership.member_id == member_id, Membership.organisation_id == organisation_id" "            Membership.organisation_id == organisation_id" tests/integration/test_tenant_isolation.py
run "another tenant's Organisation answers 403" app/tenancy/policy.py "status.HTTP_404_NOT_FOUND, NOT_FOUND" "status.HTTP_403_FORBIDDEN, NOT_FOUND" tests/integration/test_tenant_isolation.py
echo "=== unmodified"
uv run pytest -q --no-cov tests/integration/test_sign_up.py tests/integration/test_sign_in_and_out.py tests/integration/test_tenant_isolation.py 2>&1 | grep -E '^(FAILED|[0-9]+ (passed|failed))'
git status --short
