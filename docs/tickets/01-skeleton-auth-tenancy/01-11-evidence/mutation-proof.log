ok = True
for name, path, old, new, tests in M:
    src = open(path).read()
    pairs = old if new is None else [(old, new)]
    mutated = src
    for o, n in pairs:
        assert mutated.count(o) == 1, (name, o)
        mutated = mutated.replace(o, n)
    open(path, "w").write(mutated)
    try:
        r = subprocess.run(["uv", "run", "pytest", "-q", "--no-cov", "-x", *tests.split()], capture_output=True, text=True, env=env)
    finally:
        open(path, "w").write(src)
    summary = [l for l in r.stdout.splitlines() if l.startswith(("FAILED", "ERROR"))][:1] + r.stdout.strip().splitlines()[-1:]
    caught = r.returncode != 0
    ok &= caught
    print(f"{'CAUGHT' if caught else 'MISSED'}: {name}\n    {' | '.join(summary)}")
r = subprocess.run(["uv", "run", "pytest", "-q", "--no-cov", "tests/integration/test_mfa.py", "tests/unit"], capture_output=True, text=True, env=env)
print("Unmodified code:", r.stdout.strip().splitlines()[-1])
print("git status (must be clean):", subprocess.run(["git", "status", "--porcelain"], capture_output=True, text=True).stdout or "clean")
sys.exit(0 if ok and r.returncode == 0 else 1)
